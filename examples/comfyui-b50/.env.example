# Private deployment values belong in .env, never committed.
COMFY_IMAGE=llm-scaler-omni:0.2.0-b2-comfyui-bmg
COMFY_DATA=/srv/comfyui
COMFY_BIND=127.0.0.1
COMFY_PORT=8188
# Replace after checking stat -c '%g' on the live card and render nodes.
VIDEO_GID=44
RENDER_GID=110
# Verify the selected device name; ordering differs across hosts.
ZE_AFFINITY_MASK=0
