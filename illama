cmd_run() {
    local model=""
    local prompt=""
    local expect_prompt=0
    local stream_mode="auto"

    # Parse arguments: illama run <model> [prompt] or illama run <model> -p "<prompt>"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -p|--prompt)
                expect_prompt=1
                shift
                continue
                ;;
            --stream)
                stream_mode="on"
                ;;
            --no-stream)
                stream_mode="off"
                ;;
            *)
                if [[ -z "$model" ]]; then
                    model="$1"
                elif [[ $expect_prompt -eq 1 ]]; then
                    prompt="$1"
                    expect_prompt=0
                elif [[ -z "$prompt" ]]; then
                    # Backwards-compatible: second positional is prompt
                    prompt="$1"
                fi
                ;;
        esac
        shift
    done
    
    if [[ -z "$model" ]]; then
        error "Usage: illama run <model_name> [prompt] or illama run <model_name> -p \"prompt\""
    fi
    
    # Check if service is running
    if ! docker ps -q -f name="$CONTAINER_NAME" | grep -q .; then
        warn "Service not running. Starting..."
        cmd_serve
    fi
    
    # Build a chat request body safely. Takes the messages JSON on stdin and
    # writes the full request body to stdout. Avoids shell-into-JSON splicing.
    build_request_body() {
        local messages_json="$1"
        local stream="$2"
        ILLAMA_MODEL="$model" ILLAMA_STREAM="$stream" python3 - "$messages_json" <<'PY'
import json, os, sys
messages = json.loads(sys.argv[1])
body = {
    "model": os.environ["ILLAMA_MODEL"],
    "messages": messages,
    "max_tokens": 4096,
    "stream": os.environ["ILLAMA_STREAM"] == "true",
}
if body["stream"]:
    body["stream_options"] = {"include_usage": True}
print(json.dumps(body))
PY
    }

    # Helper function to make API call - returns content and usage as separate lines
    make_request() {
        local messages_json="$1"
        local body
        body=$(build_request_body "$messages_json" "false") || return 1

        local response
        response=$(curl_api -s -X POST "http://localhost:$PORT/v1/chat/completions" \
            -H "Content-Type: application/json" \
            --data-binary @- <<<"$body")

        debug "Raw API response: $response"

        # Parse response with proper error handling - output content, then stats on stderr.
        # NOTE: We pass the response through an env var (ILLAMA_API_RESPONSE) instead of
        # piping into stdin. With `python3 - <<'PY'`, the heredoc redirection wins over
        # the pipe, so `json.load(sys.stdin)` would read the (already-consumed) script
        # source and always fail with "Invalid JSON response". This used to break
        # non-streaming `illama run` for everyone.
        ILLAMA_API_RESPONSE="$response" python3 - <<'PY'
import os, sys, json
try:
    data = json.loads(os.environ.get("ILLAMA_API_RESPONSE", ""))
    if "error" in data:
        err = data["error"]
        msg = err.get("message", str(err)) if isinstance(err, dict) else str(err)
        print(f"API Error: {msg}", file=sys.stderr)
        sys.exit(1)
    if "choices" not in data or len(data["choices"]) == 0:
        print("Error: Empty response from server", file=sys.stderr)
        sys.exit(1)
    content = data["choices"][0]["message"]["content"]
    print(content)
    if "usage" in data:
        usage = data["usage"]
        tps = usage.get("tokens_per_second", 0)
        gen_time = usage.get("generation_time_seconds", 0)
        print(
            f"STATS:{usage.get('prompt_tokens',0)}:{usage.get('completion_tokens',0)}:"
            f"{usage.get('total_tokens',0)}:{tps}:{gen_time}",
            file=sys.stderr,
        )
except json.JSONDecodeError:
    print("Error: Invalid JSON response", file=sys.stderr)
    sys.exit(1)
except Exception as e:
    print(f"Error: {e}", file=sys.stderr)
    sys.exit(1)
PY
    }

    make_request_stream() {
        local messages_json="$1"
        local content_file="$2"
        local stats_file="$3"
        local body
        body=$(build_request_body "$messages_json" "true") || return 1
        curl_api -sN -X POST "http://localhost:$PORT/v1/chat/completions" \
            -H "Content-Type: application/json" \
            --data-binary @- <<<"$body" | \
        python3 -c "
import json, sys

content_path = sys.argv[1]
stats_path = sys.argv[2]
chunks = []
usage_payload = None

def emit_error(err):
    if isinstance(err, dict):
        msg = err.get('message', str(err))
    else:
        msg = str(err)
    print(f'API Error: {msg}', file=sys.stderr)

for raw in sys.stdin:
    line = raw.strip()
    if not line or not line.startswith('data: '):
        continue
    payload = line[6:]
    if payload == '[DONE]':
        break
    try:
        data = json.loads(payload)
    except json.JSONDecodeError:
        continue
    if 'error' in data:
        emit_error(data['error'])
        sys.exit(1)
    if 'usage' in data and isinstance(data['usage'], dict):
        usage_payload = data['usage']
        continue
    choices = data.get('choices') or []
    if not choices:
        continue
    choice = choices[0]
    delta = choice.get('delta')
    text = ''
    if isinstance(delta, dict):
        text = delta.get('content') or ''
    if not text:
        text = choice.get('text') or ''
    if text:
        chunks.append(text)
        print(text, end='', flush=True)

with open(content_path, 'w', encoding='utf-8') as f:
    f.write(''.join(chunks))

if usage_payload is not None:
    with open(stats_path, 'w', encoding='utf-8') as f:
        json.dump(usage_payload, f)

if chunks:
    print()
" "$content_file" "$stats_file"
    }
    
    # Single-shot mode: prompt provided as argument
    if [[ -n "$prompt" ]]; then
        debug "Single-shot mode with prompt: $prompt"

        # Build messages JSON safely — pass prompt via sys.argv so it cannot
        # be interpreted as Python source.
        local messages_json
        messages_json=$(python3 - "$prompt" <<'PY'
import json, sys
print(json.dumps([{"role": "user", "content": sys.argv[1]}]))
PY
        )

        local effective_stream="$stream_mode"
        if [[ "$effective_stream" == "auto" ]]; then
            effective_stream="off"
        fi

        if [[ "$effective_stream" == "on" ]]; then
            local content_file=$(mktemp)
            local stats_file=$(mktemp)
            make_request_stream "$messages_json" "$content_file" "$stats_file"
            local exit_code=$?
            if [[ $exit_code -eq 0 && -s "$stats_file" ]]; then
                python3 - "$stats_file" <<'PY' 2>/dev/null || true
import json, sys
with open(sys.argv[1], "r", encoding="utf-8") as f:
    usage = json.load(f)
print()
print("\033[0;34m───────────────────────────────────────\033[0m")
print(
    f"\033[0;34m📊 Stats:\033[0m tokens={usage.get('total_tokens',0)} "
    f"(prompt={usage.get('prompt_tokens',0)}, completion={usage.get('completion_tokens',0)})"
)
print(
    f"\033[0;34m⚡ Speed:\033[0m {usage.get('tokens_per_second',0)} tokens/sec "
    f"({usage.get('generation_time_seconds',0)}s)"
)
PY
            fi
            rm -f "$content_file"
            rm -f "$stats_file"
            return $exit_code
        fi
        
        # Capture both stdout (content) and stderr (stats)
        local output_file=$(mktemp)
        local error_file=$(mktemp)
        make_request "$messages_json" > "$output_file" 2> "$error_file"
        local exit_code=$?
        
        # Display content
        cat "$output_file"
        
        # Check for errors or stats
        if [[ $exit_code -eq 0 ]]; then
            # Parse and display stats if present
            local stats_line=$(grep "^STATS:" "$error_file" 2>/dev/null)
            if [[ -n "$stats_line" ]]; then
                local prompt_tokens=$(echo "$stats_line" | cut -d: -f2)
                local completion_tokens=$(echo "$stats_line" | cut -d: -f3)
                local total_tokens=$(echo "$stats_line" | cut -d: -f4)
                local tps=$(echo "$stats_line" | cut -d: -f5)
                local gen_time=$(echo "$stats_line" | cut -d: -f6)
                echo ""
                echo -e "${BLUE}───────────────────────────────────────${NC}"
                echo -e "${BLUE}📊 Stats:${NC} tokens=$total_tokens (prompt=$prompt_tokens, completion=$completion_tokens)"
                echo -e "${BLUE}⚡ Speed:${NC} ${tps} tokens/sec (${gen_time}s)"
            fi
        else
            # Show error (filter out STATS line)
            grep -v "^STATS:" "$error_file" >&2
        fi
        
        rm -f "$output_file" "$error_file"
        return $exit_code
    fi
    
    # Interactive chat mode
    echo ""
    echo "=== Chat with $model ==="
    echo "Type 'bye' or Ctrl+C to exit"
    echo ""
    
    local history='[]'
    local effective_stream="$stream_mode"
    if [[ "$effective_stream" == "auto" ]]; then
        effective_stream="on"
    fi
    
    while true; do
        read -p "You: " user_input
        
        if [[ "$user_input" == "bye" ]] || [[ "$user_input" == "exit" ]] || [[ "$user_input" == "quit" ]]; then
            echo "Goodbye!"
            break
        fi
        
        if [[ -z "$user_input" ]]; then
            continue
        fi
        
        # Build messages JSON safely using Python with sys.argv (avoids quote issues)
        local messages_json=$(python3 -c "
import json, sys
history = json.loads(sys.argv[1])
history.append({'role': 'user', 'content': sys.argv[2]})
print(json.dumps(history))
" "$history" "$user_input")
        
        if [[ "$effective_stream" == "on" ]]; then
            local content_file=$(mktemp)
            local stats_file=$(mktemp)
            echo ""
            echo -ne "${GREEN}AI:${NC} "
            make_request_stream "$messages_json" "$content_file" "$stats_file"
            local exit_code=$?
            local assistant_msg=$(cat "$content_file" 2>/dev/null)
            rm -f "$content_file"
            if [[ $exit_code -eq 0 && -s "$stats_file" ]]; then
                python3 - "$stats_file" <<'PY' 2>/dev/null || true
import json, sys
with open(sys.argv[1], "r", encoding="utf-8") as f:
    usage = json.load(f)
print("\033[0;34m───────────────────────────────────────\033[0m")
print(
    f"\033[0;34m📊 Stats:\033[0m tokens={usage.get('total_tokens',0)} "
    f"(prompt={usage.get('prompt_tokens',0)}, completion={usage.get('completion_tokens',0)})"
)
print(
    f"\033[0;34m⚡ Speed:\033[0m {usage.get('tokens_per_second',0)} tokens/sec "
    f"({usage.get('generation_time_seconds',0)}s)"
)
PY
            fi
            rm -f "$stats_file"
            if [[ $exit_code -ne 0 ]]; then
                echo ""
                continue
            fi
            echo ""
        else
            # Call API
            local assistant_msg=$(make_request "$messages_json")
            
            if [[ $? -ne 0 ]]; then
                echo -e "${RED}$assistant_msg${NC}"
                continue
            fi
            
            echo ""
            echo -e "${GREEN}AI:${NC} $assistant_msg"
            echo ""
        fi
        
        # Update history safely
        history=$(python3 -c "
import json, sys
history = json.loads(sys.argv[1])
history.append({'role': 'assistant', 'content': sys.argv[2]})
print(json.dumps(history))
" "$messages_json" "$assistant_msg")
    done
}

