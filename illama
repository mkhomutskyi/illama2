# Reports the loaded model name as printed by /illama/health, or empty string
# if the runner is not reachable. Used by cmd_gc to skip the live model and
# by cmd_doctor to surface "what's loaded right now".
_loaded_model_name() {
    if ! docker ps --format '{{.Names}}' 2>/dev/null | grep -qx "$CONTAINER_NAME"; then
        return 0
    fi
    local body
    body="$(curl -fsS --max-time 3 "${HEALTH_URL}" 2>/dev/null || true)"
    if [[ -z "$body" ]]; then
        return 0
    fi
    ILLAMA_HEALTH_BODY="$body" python3 - <<'PY' 2>/dev/null || true
import json, os
try:
    body = json.loads(os.environ.get("ILLAMA_HEALTH_BODY") or "{}")
except Exception:
    raise SystemExit(0)
loaded = body.get("loaded_model") or ""
if loaded:
    print(loaded)
PY
}

cmd_gc() {
    # Reclaim disk space from the registry: prune the HF download cache and
    # any model directories that are missing the OpenVINO artifacts (i.e. an
    # interrupted pull/conversion left a partial tree behind).
    #
    # Flags:
    #   --dry-run      Show what would be removed; do not delete anything.
    #   --force        Skip the confirmation prompt.
    #   --keep-cache   Keep ${REGISTRY}/.cache/ (HuggingFace download cache)
    #                  and only remove broken model dirs.
    local dry_run=0 force=0 keep_cache=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run) dry_run=1; shift ;;
            --force|-f) force=1; shift ;;
            --keep-cache) keep_cache=1; shift ;;
            -h|--help)
                cat <<EOF
Usage: illama gc [--dry-run] [--force] [--keep-cache]

Removes the HuggingFace download cache (\${REGISTRY}/.cache) and any model
directories under \${REGISTRY} that are missing the OpenVINO artifact
(openvino_model.xml or openvino_language_model.xml). The currently-loaded
model is never touched.

  --dry-run      Show what would be removed; do not delete anything.
  --force, -f    Skip the confirmation prompt.
  --keep-cache   Keep the HF download cache; only remove broken model dirs.
EOF
                return 0
                ;;
            *)
                error "Unknown gc flag: $1. Try 'illama gc --help'."
                ;;
        esac
    done

    if [[ ! -d "$REGISTRY" ]]; then
        log "Registry not found at $REGISTRY - nothing to GC."
        return 0
    fi

    local loaded
    loaded="$(_loaded_model_name | head -n 1)"
    [[ -n "$loaded" ]] && debug "Skipping currently-loaded model: $loaded"

    # Find broken model dirs (top-level dirs under REGISTRY that have no
    # openvino artifact). Skip the .cache subdir and the loaded model.
    local broken=()
    local total_broken_bytes=0
    local entry name
    for entry in "$REGISTRY"/*/; do
        [[ -d "$entry" ]] || continue
        name="$(basename "$entry")"
        [[ "$name" == ".cache" ]] && continue
        [[ -n "$loaded" && "$name" == "$loaded" ]] && continue
        if ! _model_dir_has_artifact "$entry"; then
            broken+=("$entry")
            local sz
            sz="$(du -sb "$entry" 2>/dev/null | awk '{print $1}')"
            [[ -n "$sz" ]] && total_broken_bytes=$((total_broken_bytes + sz))
        fi
    done

    local cache_dir="${REGISTRY}/.cache"
    local cache_bytes=0
    if [[ $keep_cache -eq 0 && -d "$cache_dir" ]]; then
        cache_bytes="$(du -sb "$cache_dir" 2>/dev/null | awk '{print $1}')"
        cache_bytes="${cache_bytes:-0}"
    fi

    if [[ ${#broken[@]} -eq 0 && $cache_bytes -eq 0 ]]; then
        success "Nothing to clean up. Registry is healthy."
        return 0
    fi

    echo ""
    echo "Reclaim plan:"
    if [[ ${#broken[@]} -gt 0 ]]; then
        echo "  Broken / partial model directories:"
        for entry in "${broken[@]}"; do
            local sz_h
            sz_h="$(du -sh "$entry" 2>/dev/null | cut -f1)"
            echo "    - ${entry} (${sz_h:-?})"
        done
        printf "  Total broken size: %s\n" \
            "$(numfmt --to=iec --suffix=B "$total_broken_bytes" 2>/dev/null || echo "${total_broken_bytes}B")"
    fi
    if [[ $cache_bytes -gt 0 ]]; then
        local cache_h
        cache_h="$(du -sh "$cache_dir" 2>/dev/null | cut -f1)"
        echo "  HuggingFace download cache:"
        echo "    - ${cache_dir} (${cache_h:-?})"
    fi
    echo ""

    if [[ $dry_run -eq 1 ]]; then
        log "Dry run - no changes made. Re-run without --dry-run to apply."
        return 0
    fi

    if [[ $force -eq 0 ]]; then
        local reply
        read -r -p "Proceed with deletion? [y/N] " reply
        case "$reply" in
            y|Y|yes|YES) ;;
            *)
                warn "Aborted by user."
                return 0
                ;;
        esac
    fi

    for entry in "${broken[@]}"; do
        log "Removing broken model dir: $entry"
        sudo rm -rf "$entry" 2>/dev/null || rm -rf "$entry" 2>/dev/null || \
            warn "Failed to remove $entry"
    done

    if [[ $cache_bytes -gt 0 ]]; then
        log "Removing HF download cache: $cache_dir"
        sudo rm -rf "$cache_dir" 2>/dev/null || rm -rf "$cache_dir" 2>/dev/null || \
            warn "Failed to remove $cache_dir"
    fi

    success "GC complete."
}

cmd_doctor() {
    # Run a battery of read-only health checks and print a pass/warn/fail
    # summary. Useful when something is wrong and you want to know whether
    # the issue is host setup, container state, GPU access, or runner.
    local fail_count=0
    local warn_count=0
    local pass_count=0

    _doc_pass() { echo -e "  ${GREEN}✅${NC} $1"; pass_count=$((pass_count + 1)); }
    _doc_warn() { echo -e "  ${YELLOW}⚠️${NC}  $1"; warn_count=$((warn_count + 1)); }
    _doc_fail() { echo -e "  ${RED}❌${NC} $1"; fail_count=$((fail_count + 1)); }

    echo ""
    echo "${BLUE}illama doctor${NC} - host and runtime checks"
    echo ""

    echo "[1/6] Host prerequisites"
    if command -v docker >/dev/null 2>&1; then
        _doc_pass "docker available ($(docker --version 2>/dev/null | cut -d, -f1))"
        if docker info >/dev/null 2>&1; then
            _doc_pass "docker daemon reachable"
        else
            _doc_fail "docker daemon not reachable - try 'sudo usermod -aG docker \$USER && newgrp docker'"
        fi
    else
        _doc_fail "docker not installed - https://get.docker.com"
    fi
    if command -v python3 >/dev/null 2>&1; then
        _doc_pass "python3 available ($(python3 --version 2>/dev/null))"
    else
        _doc_fail "python3 not installed - 'sudo apt install python3'"
    fi
    if command -v curl >/dev/null 2>&1; then
        _doc_pass "curl available"
    else
        _doc_warn "curl not installed - 'illama bench' and many checks degrade gracefully"
    fi
    echo ""

    echo "[2/6] Filesystem layout"
    if [[ -d "$ILLAMA_HOME" ]]; then
        _doc_pass "ILLAMA_HOME exists at $ILLAMA_HOME"
    else
        _doc_fail "ILLAMA_HOME missing at $ILLAMA_HOME - re-run setup.sh"
    fi
    if [[ -d "$REGISTRY" ]]; then
        _doc_pass "registry directory exists at $REGISTRY"
    else
        _doc_warn "registry missing at $REGISTRY - 'illama pull' will create it"
    fi
    if [[ -f "${ILLAMA_HOME}/runner/Dockerfile" ]]; then
        _doc_pass "runner Dockerfile present"
    else
        _doc_fail "runner Dockerfile missing - re-run setup.sh"
    fi
    if [[ -f "${ILLAMA_HOME}/builder/Dockerfile" ]]; then
        _doc_pass "builder Dockerfile present"
    else
        _doc_warn "builder Dockerfile missing - 'illama pull' on raw HF repos will fail"
    fi
    if [[ -f "${ILLAMA_HOME}/VERSION" ]]; then
        _doc_pass "VERSION file present (${ILLAMA_VERSION})"
    else
        _doc_warn "VERSION file missing - 'illama version' falls back to 'unknown'"
    fi
    echo ""

    echo "[3/6] Docker images"
    if docker image inspect "$RUNNER_IMG" >/dev/null 2>&1; then
        _doc_pass "$RUNNER_IMG present"
    else
        _doc_fail "$RUNNER_IMG missing - re-run setup.sh or 'docker build runner/'"
    fi
    if docker image inspect "$BUILDER_IMG" >/dev/null 2>&1; then
        _doc_pass "$BUILDER_IMG present"
    else
        _doc_warn "$BUILDER_IMG not built yet - will build lazily on first non-OpenVINO pull (~5 GB)"
    fi
    echo ""

    echo "[4/6] GPU access"
    if [[ -e /dev/dri ]]; then
        _doc_pass "/dev/dri found"
        if groups 2>/dev/null | grep -q video; then
            _doc_pass "user in 'video' group"
        else
            _doc_warn "user not in 'video' group - 'sudo usermod -aG video \$USER && newgrp video'"
        fi
        if groups 2>/dev/null | grep -q render; then
            _doc_pass "user in 'render' group"
        else
            _doc_warn "user not in 'render' group - 'sudo usermod -aG render \$USER && newgrp render'"
        fi
    else
        _doc_warn "/dev/dri not present - inference will fall back to CPU"
    fi
    echo ""

    echo "[5/6] Runner service"
    if docker ps --format '{{.Names}}' 2>/dev/null | grep -qx "$CONTAINER_NAME"; then
        _doc_pass "container $CONTAINER_NAME is running"
        local body
        body="$(curl -fsS --max-time 3 "$HEALTH_URL" 2>/dev/null || true)"
        if [[ -n "$body" ]]; then
            _doc_pass "/illama/health responding on port $PORT"
            local loaded
            loaded="$(_loaded_model_name | head -n 1)"
            if [[ -n "$loaded" ]]; then
                _doc_pass "loaded model: $loaded"
            else
                _doc_warn "no model currently loaded (idle)"
            fi
        else
            _doc_fail "/illama/health on port $PORT not responding - check 'illama logs'"
        fi
    else
        _doc_warn "container $CONTAINER_NAME not running - 'illama serve' to start"
    fi
    echo ""

    echo "[6/6] Registry contents"
    local model_count=0
    local broken_count=0
    if [[ -d "$REGISTRY" ]]; then
        for entry in "$REGISTRY"/*/; do
            [[ -d "$entry" ]] || continue
            local name
            name="$(basename "$entry")"
            [[ "$name" == ".cache" ]] && continue
            model_count=$((model_count + 1))
            if ! _model_dir_has_artifact "$entry"; then
                broken_count=$((broken_count + 1))
            fi
        done
        if [[ $model_count -eq 0 ]]; then
            _doc_warn "no models in registry yet - 'illama pull <repo>' to add one"
        elif [[ $broken_count -eq 0 ]]; then
            _doc_pass "$model_count model(s), all have OpenVINO artifacts"
        else
            _doc_warn "$model_count model(s), $broken_count broken/partial - run 'illama gc'"
        fi
    fi
    echo ""

    echo "Summary:"
    echo "  ${GREEN}pass=${pass_count}${NC}  ${YELLOW}warn=${warn_count}${NC}  ${RED}fail=${fail_count}${NC}"
    if [[ $fail_count -gt 0 ]]; then
        return 1
    fi
    return 0
}

cmd_logs() {
    local lines="${1:-100}"
    case "$lines" in
        ''|*[!0-9]*)
            error "Usage: illama logs [N]   (N = number of recent lines, default 100)"
            ;;
    esac

    if [[ -z $(docker ps -aq -f name="^${CONTAINER_NAME}$") ]]; then
        warn "Service has never been started. Run 'illama serve' first."
        return 0
    fi
    docker logs -f --tail "$lines" "$CONTAINER_NAME"
}

cmd_bench() {
    local script_path="${ILLAMA_HOME}/scripts/benchmark_api.py"
    if [[ ! -f "$script_path" ]]; then
        error "benchmark_api.py not found at $script_path. Re-run setup.sh."
    fi

    if [[ -z $(docker ps -q -f name="^${CONTAINER_NAME}$") ]]; then
        warn "Service not running. Starting..."
        cmd_serve
    fi

    local args=(--base-url "http://localhost:${PORT}/v1")
    if [[ -n "$API_KEY" ]]; then
        args+=(--api-key "$API_KEY")
    fi
    python3 "$script_path" "${args[@]}" "$@"
}

cmd_search() {
    # Browse the HuggingFace OpenVINO model index from the CLI and one-step
    # pull a selected entry. Defaults: trending, 20 results. --vlm filters to
    # image-text-to-text. The HF API call is a plain GET; no auth needed for
    # public listings (HF_TOKEN is honored if exported).
    local query=""
    local pipeline_tag=""
    local limit="20"
    local sort="trending"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --vlm)
                pipeline_tag="image-text-to-text"
                shift
                ;;
            --limit)
                if [[ -z "${2:-}" ]]; then
                    error "--limit requires a value"
                fi
                limit="$2"
                shift 2
                ;;
            --sort)
                if [[ -z "${2:-}" ]]; then
                    error "--sort requires a value"
                fi
                sort="$2"
                shift 2
                ;;
            --help|-h)
                cat <<EOF
Usage: illama search [query] [--vlm] [--limit N] [--sort trending|downloads|likes]

Browse https://huggingface.co/models?library=openvino interactively and
optionally pull the picked model in one step.

Options:
  --vlm        Restrict to image-text-to-text (Vision Language Models)
  --limit N    Number of results (default 20, capped at 100 by HF)
  --sort S     trending (default) | downloads | likes
EOF
                return 0
                ;;
            --*)
                error "Unknown flag: $1 (try 'illama search --help')"
                ;;
            *)
                if [[ -z "$query" ]]; then
                    query="$1"
                else
                    query="$query $1"
                fi
                shift
                ;;
        esac
    done

    case "$sort" in
        trending|downloads|likes) ;;
        *) error "--sort must be one of: trending, downloads, likes (got: '$sort')" ;;
    esac

    if ! [[ "$limit" =~ ^[1-9][0-9]*$ ]]; then
        error "--limit must be a positive integer (got: '$limit')"
    fi
    if (( limit > 100 )); then
        warn "Capping --limit at 100 (HuggingFace API limit)."
        limit=100
    fi

    # URL-encode the query through python3 to avoid a sed/awk dance and so
    # exotic characters (spaces, +, &) don't break the URL.
    #
    # API quirks worth knowing:
    #   - The website filter `?library=openvino` is a no-op on /api/models
    #     (silently ignored). The actual tag filter is `filter=openvino`.
    #   - The API does NOT accept `sort=trending`; the field is
    #     `sort=trendingScore` with `direction=-1` for descending. Same for
    #     downloads / likes.
    #
    # Note: `local var=$(cmd) || error` does NOT propagate cmd's exit status -
    # `local` itself returns 0, masking failure. So we declare and assign on
    # separate lines and check $? on the assignment.
    local url
    url=$(QUERY="$query" PIPELINE_TAG="$pipeline_tag" SORT="$sort" LIMIT="$limit" \
        python3 -c '
import os, urllib.parse
sort_field_map = {
    "trending": "trendingScore",
    "downloads": "downloads",
    "likes": "likes",
}
params = {
    "filter": "openvino",
    "sort": sort_field_map[os.environ["SORT"]],
    "direction": "-1",
    "limit": os.environ["LIMIT"],
}
q = os.environ["QUERY"].strip()
if q:
    params["search"] = q
tag = os.environ["PIPELINE_TAG"].strip()
if tag:
    params["pipeline_tag"] = tag
print("https://huggingface.co/api/models?" + urllib.parse.urlencode(params))
') || error "Failed to build search URL."

    debug "Search URL: $url"
    log "🔎 Searching huggingface.co for OpenVINO models..."

    # Pass HF_TOKEN if the user has one exported; the API doesn't require it
    # for public listings but gated repos need it to be visible.
    local -a curl_headers=(-H "Accept: application/json")
    if [[ -n "${HF_TOKEN:-}" ]]; then
        curl_headers+=(-H "Authorization: Bearer ${HF_TOKEN}")
    fi

    local body
    body=$(curl -fsS --max-time 15 "${curl_headers[@]}" "$url") || \
        error "HuggingFace search failed (network error or HTTP error)."
    if [[ -z "$body" ]]; then
        error "HuggingFace returned an empty response."
    fi

    # Render the table and emit the picked-id list separately, separated by a
    # sentinel line so the bash side can split them without parsing JSON twice.
    # The body is passed via env var so the python3 -c script can use a normal
    # single-quoted shell argument with no quote juggling, and so we don't have
    # to dance around `python3 -` consuming the heredoc as its script.
    local rendered
    rendered=$(ILLAMA_HF_BODY="$body" python3 -c '
import os, json, sys
from datetime import datetime, timezone

def fmt_age(iso):
    if not iso:
        return "-"
    try:
        dt = datetime.strptime(iso[:19], "%Y-%m-%dT%H:%M:%S").replace(tzinfo=timezone.utc)
    except Exception:
        return iso[:10]
    delta = datetime.now(timezone.utc) - dt
    days = delta.days
    if days < 1:
        h = delta.seconds // 3600
        return "just now" if h < 1 else "{} hours ago".format(h)
    if days < 30:
        return "{} days ago".format(days)
    months = days // 30
    if months < 12:
        return "{} months ago".format(months)
    return "{} years ago".format(months // 12)

raw = os.environ.get("ILLAMA_HF_BODY", "")
try:
    data = json.loads(raw)
except json.JSONDecodeError as e:
    print("ERROR: failed to parse HF response: {}".format(e), file=sys.stderr)
    sys.exit(2)
if not isinstance(data, list):
    print("ERROR: unexpected response shape (expected a list)", file=sys.stderr)
    sys.exit(2)

header = "{:<4}{:<60}{:<22}{:>10}  {:>6}  {}".format(
    "#", "NAME", "TYPE", "DLs", "LIKES", "UPDATED"
)
print()
print(header)
print("-" * 120)
ids = []
for i, m in enumerate(data, 1):
    mid = m.get("id", "")
    pt = m.get("pipeline_tag") or "-"
    dl = m.get("downloads") or 0
    likes = m.get("likes") or 0
    upd = m.get("lastModified") or m.get("createdAt") or ""
    name = mid if len(mid) <= 58 else mid[:55] + "..."
    print("{:<4}{:<60}{:<22}{:>10}  {:>6}  {}".format(
        i, name, pt, dl, likes, fmt_age(upd)
    ))
    ids.append(mid)
print("---ILLAMA-IDS-BEGIN---")
for mid in ids:
    print(mid)
print("---ILLAMA-IDS-END---")
') || error "Failed to parse HuggingFace response."

    local sentinel="---ILLAMA-IDS-BEGIN---"
    local table_part="${rendered%%$sentinel*}"
    local ids_block="${rendered#*$sentinel}"
    ids_block="${ids_block%---ILLAMA-IDS-END---*}"

    printf '%s' "$table_part"

    local -a ids=()
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        ids+=("$line")
    done <<< "$ids_block"

    if (( ${#ids[@]} == 0 )); then
        echo ""
        warn "No models matched the query."
        return 0
    fi

    echo ""
    local selection=""
    read -p "Pull which one? [1-${#ids[@]} / Enter to skip]: " selection
    if [[ -z "$selection" ]]; then
        return 0
    fi
    if ! [[ "$selection" =~ ^[1-9][0-9]*$ ]] || (( selection < 1 || selection > ${#ids[@]} )); then
        error "Invalid selection: '$selection'"
    fi
    local picked="${ids[$((selection - 1))]}"
    log "→ Pulling ${picked}"
    cmd_pull "$picked"
}

cmd_prune() {
    local target="${1:-builder}"
    case "$target" in
        builder)
            if ! docker image inspect "$BUILDER_IMG" >/dev/null 2>&1; then
                warn "Builder image not present — nothing to prune."
                return 0
            fi
            read -p "Remove builder image $BUILDER_IMG (~5 GB)? [y/N]: " confirm
            if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
                return 0
            fi
            docker image rm "$BUILDER_IMG"
            success "Builder image removed. It will be rebuilt on the next non-OpenVINO 'illama pull'."
            ;;
        *)
            error "Usage: illama prune [builder]"
            ;;
    esac
}

# ============================================================================
# Main
# ============================================================================

# Parse global options
while [[ $# -gt 0 ]]; do
    case "$1" in
        -v|--verbose)
            VERBOSE=1
            shift
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        *)
            break
            ;;
    esac
done

# Ensure directories exist
mkdir -p "$REGISTRY" "${ILLAMA_HOME}/config" "${ILLAMA_HOME}/cache"

# Route to command
case "${1:-}" in
    serve)
        cmd_serve
        ;;
    stop)
        cmd_stop
        ;;
    ps)
        cmd_ps
        ;;
    pull)
        shift
        cmd_pull "$@"
        ;;
    link)
        cmd_link "${2:-}" "${3:-}" "${4:-4}"
        ;;
    unlink)
        cmd_unlink "${2:-}"
        ;;
    search)
        shift
        cmd_search "$@"
        ;;
    list)
        shift
        cmd_list "$@"
        ;;
    rm)
        cmd_rm "$2"
        ;;
    show)
        cmd_show "$2"
        ;;
    run)
        shift
        cmd_run "$@"
        ;;
    logs)
        cmd_logs "${2:-}"
        ;;
    bench)
        shift
        cmd_bench "$@"
        ;;
    prune)
        cmd_prune "${2:-builder}"
        ;;
    gc)
        shift
        cmd_gc "$@"
        ;;
    doctor)
        cmd_doctor
        ;;
    version)
        cmd_version
        ;;
    "")
        show_help
        ;;
    *)
        error "Unknown command: $1. Run 'illama --help' for usage."
        ;;
esac
