# Illama runner - docker-compose environment.
#
# Copy this file to deploy/.env and tweak per host. Every value has a
# sensible default in deploy/docker-compose.yml so a bare `docker compose
# up -d` works against a stock /opt/illama install.

# ============================================================================
# Image + version
# ============================================================================

# Tag of the runner image to launch. setup.sh builds two tags per release:
# `illama-runner:latest` (rolling pointer) and `illama-runner:<version>`
# (immutable rollback target). Pin to the version when you want to make
# the running tag explicit:
#
#   ILLAMA_RUNNER_TAG=2.6.0
ILLAMA_RUNNER_TAG=latest

# ============================================================================
# Filesystem layout
# ============================================================================

# Base directory where setup.sh installs the registry, config, and cache.
# Override only if you ran `./setup.sh` against a non-default
# ILLAMA_HOME (rare).
ILLAMA_HOME=/opt/illama

# ============================================================================
# Networking
# ============================================================================

# Host-side port. Inside the container the runner always listens on 8000.
# 11434 matches the Ollama default so existing OpenWebUI/Ollama clients
# work without reconfiguration.
ILLAMA_PORT=11434

# ============================================================================
# Inference device
# ============================================================================

# GPU (Intel iGPU / dGPU via OpenVINO) or CPU. GPU requires /dev/dri to
# be present and the host user to be in the video + render groups.
ILLAMA_DEVICE=GPU

# Host group IDs for /dev/dri access. Values for stock Ubuntu 24.04+ are
# 44 (video) and 110 (render). Confirm on your host with:
#
#   getent group video render
#
# If render is missing entirely, leave the value at 110 - docker will
# accept it and the container just won't get that supplementary group.
HOST_VIDEO_GID=44
HOST_RENDER_GID=110

# ============================================================================
# Server behaviour
# ============================================================================

# Idle timeout. After this much idle time the server unloads the GPU
# pipeline; the next request reloads it (~3-15s depending on model
# size). Accepts plain seconds (300), seconds with unit (300s), minutes
# (5m), or hours (1h equivalent if encoded as 3600 / 3600s). Set to 0
# to keep the model in VRAM forever. Empty falls back to the value in
# config/server.json (default 60s; bump to 600 / 5m if you have spare
# VRAM and want to skip the cold-load on subsequent prompts, or set to
# 0 to pin the model in VRAM indefinitely).
ILLAMA_IDLE_TIMEOUT=

# Optional bearer-token auth. When set, every request must include
# `Authorization: Bearer <key>` except /health and /api/version. Generate
# with: openssl rand -hex 32
ILLAMA_API_KEY=

# SSRF guard for VLM image_url fetches. By default the runner rejects
# URLs that resolve to private / loopback / link-local IPs (e.g. cloud
# metadata service at 169.254.169.254). Set to 1 ONLY on trusted private
# networks where you intentionally fetch from an internal image host.
ILLAMA_ALLOW_PRIVATE_IMAGE_URLS=

# ============================================================================
# Diagnostics
# ============================================================================

# Override the version string surfaced by /, /api/version, and the
# OpenAPI metadata. Normally baked at build time from the VERSION file,
# so leaving this empty is correct.
ILLAMA_VERSION=
